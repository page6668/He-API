{
  "name": "@he-api/i18n-keys",
  "version": "0.0.0",
  "private": true,
  "description": "Types-only shared package: codegen'd i18n key unions for the He-API console (Story 2.1).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./common": {
      "types": "./src/common.ts",
      "default": "./src/common.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsx ../../scripts/gen-i18n-keys.ts && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}
