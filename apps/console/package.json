{
  "name": "@he-api/console",
  "version": "0.0.0",
  "private": true,
  "description": "He-API Console — Next.js 14 App Router + next-intl i18n scaffold (Story 2.1).",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true next build && size-limit"
  },
  "dependencies": {
    "@he-api/i18n-keys": "workspace:*",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "14.2.18",
    "next-intl": "^3.26.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "14.2.18",
    "@playwright/test": "^1.49.0",
    "@size-limit/file": "^11.1.6",
    "@size-limit/preset-app": "^11.1.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.16.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "size-limit": "^11.1.6",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.1"
  },
  "size-limit": [
    {
      "name": "console first-load JS (gzip, shared + [locale] page)",
      "path": [
        ".next/static/chunks/[locale]/page-*.js",
        ".next/static/chunks/main-app-*.js",
        ".next/static/chunks/webpack-*.js",
        ".next/static/chunks/framework-*.js",
        ".next/static/chunks/[0-9a-f]*.js"
      ],
      "limit": "250 KB",
      "gzip": true,
      "brotli": false,
      "running": false
    }
  ]
}
