# =============================================================================
# He-API Analytics Service 环境变量 (监听端口 9006)
# 变量名与 apps/analytics-svc 代码严格对应。
# 注意：ClickHouse 变量名为 HE_API_CLICKHOUSE_DSN（非 _URI）。
# =============================================================================

PORT=9006
HE_API_CLICKHOUSE_DSN=clickhouse://default:@localhost:9000/he_api
HE_API_CLICKHOUSE_TEST_DSN=clickhouse://default:@localhost:9000/he_api
HE_API_KAFKA_BROKERS=localhost:9092
# GDPR 数据导出存放的 OSS bucket
HE_API_OSS_GDPR_EXPORTS_BUCKET=he-api-gdpr-exports
