# ============================================================
# He-API Analytics Service — 环境变量配置
# 路径：/opt/he-api/env/analytics.env
# ============================================================

# --- Kafka ---
HE_API_KAFKA_BROKERS=localhost:9092

# --- ClickHouse（分析数据存储） ---
HE_API_CLICKHOUSE_URI=???          # 例：clickhouse://default:password@localhost:9000/heapi

# --- OSS（对象存储，存放报表导出等） ---
HE_API_OSS_ENDPOINT=???             # 例：https://oss-cn-hangzhou.aliyuncs.com
HE_API_OSS_ACCESS_KEY_ID=???
HE_API_OSS_ACCESS_KEY_SECRET=???
HE_API_OSS_BUCKET=???

# --- OpenTelemetry ---
HE_API_OTEL_EXPORTER_OTLP_ENDPOINT=???

# --- 日志 ---
HE_API_LOG_LEVEL=info

# --- 监听端口 ---
PORT=9006
