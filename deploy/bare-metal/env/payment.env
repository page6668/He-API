# ============================================================
# He-API Payment Service — 环境变量配置
# 路径：/opt/he-api/env/payment.env
# ============================================================

# --- 数据库 ---
HE_API_DB_POSTGRES_URI=???

# --- Kafka ---
HE_API_KAFKA_BROKERS=localhost:9092

# --- Stripe ---
STRIPE_SECRET_KEY=???

# --- PayPal ---
PAYPAL_CLIENT_ID=???
PAYPAL_CLIENT_SECRET=???

# --- 支付宝 ---
ALIPAY_APP_ID=???
ALIPAY_PRIVATE_KEY=???
ALIPAY_PUBLIC_KEY=???

# --- 微信支付 ---
WECHAT_MCHID=???
WECHAT_API_KEY=???

# --- Coinbase Commerce ---
COINBASE_COMMERCE_API_KEY=???

# --- OpenTelemetry ---
HE_API_OTEL_EXPORTER_OTLP_ENDPOINT=???

# --- 日志 ---
HE_API_LOG_LEVEL=info

# --- 监听端口 ---
PORT=9003
