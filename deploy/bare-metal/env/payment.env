# =============================================================================
# He-API Payment Service 环境变量 (监听端口 9003)
# 变量名与 apps/payment-svc 代码严格对应。
# 未接入的支付渠道，对应密钥留空即可（该渠道 Webhook 不会被启用）。
# =============================================================================

PORT=9003

HE_API_KAFKA_BROKERS=localhost:9092

# --- Stripe ---
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_SECRET_KEY=???
STRIPE_WEBHOOK_SIGNING_SECRET=???

# --- PayPal ---
PAYPAL_API_BASE_URL=https://api.paypal.com
PAYPAL_CLIENT_ID=???
PAYPAL_CLIENT_SECRET=???
PAYPAL_WEBHOOK_ID=???

# --- Alipay+ ---
ALIPAY_PLUS_API_BASE_URL=https://openapi.alipay.com
ALIPAY_PLUS_CLIENT_ID=???
ALIPAY_PLUS_MERCHANT_PRIVATE_KEY=???
ALIPAY_PLUS_ALIPAY_PUBLIC_KEY=???
ALIPAY_PLUS_NOTIFY_PATH=/v1/payment/webhook/alipay

# --- WeChat Pay (ApiV3) ---
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_APPID=???
WECHAT_PAY_MCH_ID=???
WECHAT_PAY_APIV3_KEY=???
WECHAT_PAY_MERCHANT_PRIVATE_KEY=???
WECHAT_PAY_MERCHANT_CERT_SERIAL=???
WECHAT_PAY_PLATFORM_CERT_SERIAL=???
WECHAT_PAY_PLATFORM_PUBLIC_KEY=???
WECHAT_PAY_NOTIFY_URL=https://api.yourdomain.com/v1/payment/webhook/wechat

# --- Coinbase Commerce (USDC) ---
COINBASE_COMMERCE_API_BASE_URL=https://api.commerce.coinbase.com
COINBASE_COMMERCE_API_KEY=???
COINBASE_COMMERCE_WEBHOOK_SECRET=???
