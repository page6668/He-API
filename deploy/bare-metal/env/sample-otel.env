# ============================================================
# He-API Sample OpenTelemetry App — 环境变量配置
# 路径：/opt/he-api/env/sample-otel.env
# ============================================================

# --- 监听端口 ---
PORT=9082

# --- OpenTelemetry（与 gateway 不同的原生 OTEL 变量名） ---
OTEL_EXPORTER_OTLP_ENDPOINT=???

# --- 日志 ---
HE_API_LOG_LEVEL=info
