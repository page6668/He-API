# ============================================================
# He-API Routing Service — 环境变量配置
# 路径：/opt/he-api/env/routing.env
# ============================================================

# --- Kafka（核心依赖：消费请求路由事件）---
HE_API_KAFKA_BROKERS=localhost:9092

# --- 日志 ---
HE_API_LOG_LEVEL=info

# --- 监听端口 ---
PORT=9005
