# ============================================================
# He-API Console 环境变量
# 部署路径: /opt/he-api/env/console.env
# 由 he-api-console.service 以 EnvironmentFile 读取（运行期）。
# ============================================================
#
# ⚠️ 重要：NEXT_PUBLIC_* 是【构建期】变量，仅在 `next build` 时烘焙进
#   前端 JS bundle。修改这些值后必须重新构建（build-console.sh），
#   仅改此文件并 restart 服务【不会】生效。
#   非 NEXT_PUBLIC_* 是【运行期】变量，standalone server.js 启动时读取，
#   改完 restart 即生效。
#
# 同源部署建议（见 nginx/he-api.conf）：console 与 gateway 同一域名，
#   /  → console:3000，/v1 → gateway:8080。此时 NEXT_PUBLIC_HE_API_BASE
#   留空，playground 用相对路径 /v1/me/playground/chat，auth cookie 为
#   第一方，零跨域问题。

# ---------- 构建期（NEXT_PUBLIC_*，next build 时烘焙）----------
# 部署环境: production / staging
NEXT_PUBLIC_DEPLOY_ENV=production
# Beta 标识
NEXT_PUBLIC_BETA_MODE=false
# playground chat 的 API 基址；同源部署留空（用相对 /v1/...）
NEXT_PUBLIC_HE_API_BASE=
# OAuth 回跳用的网关基址（同源即控制台自身对外域名）
NEXT_PUBLIC_API_GATEWAY_URL=https://console.he-api.example.com
# 控制台自身对外域名（作为 CORS Origin 传给网关）
NEXT_PUBLIC_CONSOLE_ORIGIN=https://console.he-api.example.com
# Intercom 公共 App ID（留 ??? 表示不用）
NEXT_PUBLIC_INTERCOM_APP_ID=???

# ---------- 运行期（server.js 启动时读取）----------
# 裸机部署走 next start（非 standalone）；build-console.sh 构建期也设此项，
# 使 .next 产物与运行期配置一致，避免 next start 与 output:standalone 不兼容警告。
BARE_METAL_BUILD=1
NODE_ENV=production
# standalone server 监听端口（nginx 反代目标）
PORT=3000
# 控制台服务端调用网关的内部地址（同源不同端口，走 127.0.0.1）
HE_API_GATEWAY_URL=http://127.0.0.1:8080
# 公共模型目录基址（同源即控制台域名）
HE_API_PUBLIC_BASE_URL=https://console.he-api.example.com
# Intercom 身份校验开关: on / off
INTERCOM_IDENTITY_VERIFICATION=off
# Intercom 服务端密钥（INTERCOM_IDENTITY_VERIFICATION=on 时必填）
INTERCOM_SECRET=???
# 文档示例中的占位 key 名（仅展示用，切勿填真实 key）
HE_API_KEY=???
# 关闭 Next 遥测
NEXT_TELEMETRY_DISABLED=1
