# =============================================================================
# Doubao (豆包) Adapter 环境变量 (监听端口 8093)
# 变量名与 apps/adapters/doubao 代码严格对应。
# 含 TTS + ASR 能力（若不使用语音，对应 *_API_TOKEN/_APP_ID 可留空）。
# =============================================================================

PORT=8093
DOUBAO_UPSTREAM_API_KEY=???
DOUBAO_UPSTREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_UPSTREAM_TIMEOUT_SECONDS=120
DOUBAO_BOUND_MODEL_IDS=doubao-pro,doubao-lite

# --- TTS ---
DOUBAO_TTS_UPSTREAM_API_TOKEN=???
DOUBAO_TTS_UPSTREAM_APP_ID=???
DOUBAO_TTS_UPSTREAM_BASE_URL=https://openspeech.bytedance.com
DOUBAO_TTS_UPSTREAM_CLUSTER=volcano_tts
DOUBAO_TTS_UPSTREAM_PATH=/api/v1/tts
DOUBAO_TTS_UPSTREAM_VOICE_TYPE=zh_female_qingxin

# --- ASR ---
DOUBAO_ASR_UPSTREAM_API_TOKEN=???
DOUBAO_ASR_UPSTREAM_APP_ID=???
DOUBAO_ASR_UPSTREAM_BASE_URL=https://openspeech.bytedance.com
DOUBAO_ASR_UPSTREAM_CLUSTER=volcano_asr
DOUBAO_ASR_UPSTREAM_PATH=/api/v1/asr
