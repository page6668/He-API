# =============================================================================
# He-API API Gateway 环境变量 (监听端口 8080)
# 所有 ??? 必须替换为真实值。变量名与 apps/api-gateway 代码严格对应。
# =============================================================================

# 监听端口（PORT 补丁支持覆盖，默认 8080）
PORT=8080

# --- 下游服务寻址（裸机用 localhost + 端口）---
HE_API_AUTH_SVC_URL=http://localhost:9001
HE_API_NOTIFICATION_SVC_URL=http://localhost:9004
BILLING_SVC_ENDPOINT=http://localhost:9002
PAYMENT_SVC_ENDPOINT=http://localhost:9003

# --- 数据库 / 缓存 ---
HE_API_DB_POSTGRES_URI=postgres://he_api:???@localhost:5432/he_api?sslmode=disable
HE_API_REDIS_URL=redis://localhost:6379/0

# --- JWT 验签公钥（必须与 auth-svc 的私钥配对，由 install.sh 自动生成）---
HE_API_JWT_PUBLIC_KEY_PATH=/opt/he-api/keys/jwt_public.pem

# --- Kafka（发布审计/用量/请求日志事件）---
HE_API_KAFKA_BROKERS=localhost:9092

# --- ClickHouse（请求日志落库，可选；不部署 analytics-svc 可留空）---
HE_API_CLICKHOUSE_DSN=clickhouse://default:@localhost:9000/he_api
HE_API_CLICKHOUSE_TEST_DSN=clickhouse://default:@localhost:9000/he_api

# --- 模型目录同步 Models Sync（可选，全部留空则关闭自动同步）---
MODELS_SYNC_VENDOR=deepseek
MODELS_SYNC_UPSTREAM_URL=https://api.deepseek.com
MODELS_SYNC_API_KEY=???
MODELS_SYNC_DRY_RUN=false
MODELS_CATALOGUE_REFRESH_SECONDS=300

# --- 可观测性 ---
HE_API_DEPLOY_ENV=production
OTEL_EXPORTER_OTLP_ENDPOINT=???
# 网络边界 CIDR（内容安全/限流用，留空表示不限制）
CLOUDFLARE_CIDRS=
INGRESS_CIDRS=
