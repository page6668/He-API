# ============================================================
# He-API Gateway — 环境变量配置
# 路径：/opt/he-api/env/gateway.env
# 部署后请填写真实值（??? 处）
# ============================================================

# --- 数据库 ---
HE_API_DB_POSTGRES_URI=???          # 例：postgresql://heapi:password@127.0.0.1:5432/heapi

# --- Redis ---
HE_API_REDIS_URL=???                # 例：redis://127.0.0.1:6379/0

# --- 服务间调用（内部地址，无需外网访问）---
HE_API_AUTH_SVC_URL=http://127.0.0.1:9001
HE_API_NOTIFICATION_SVC_URL=http://127.0.0.1:9004
HE_API_BILLING_SVC_URL=http://127.0.0.1:9002

# --- JWT ---
HE_API_JWT_SECRET=???               # 32+ 字符随机字符串，安全性关键，请使用 openssl rand -hex 32 生成
HE_API_JWT_ISSUER=https://api.he-api.example.com

# --- CORS ---
HE_API_CORS_ORIGINS=https://console.he-api.example.com

# --- Adapter 上游（各 LLM 适配器内部地址）---
DEEPSEEK_ADAPTER_ENDPOINT=http://127.0.0.1:8091
QWEN_ADAPTER_ENDPOINT=http://127.0.0.1:8092
DOUBAO_ADAPTER_ENDPOINT=http://127.0.0.1:8093
GLM_ADAPTER_ENDPOINT=http://127.0.0.1:8094
ERNIE_ADAPTER_ENDPOINT=http://127.0.0.1:8095
KIMI_ADAPTER_ENDPOINT=http://127.0.0.1:8096

# --- Kafka ---
HE_API_KAFKA_BROKERS=localhost:9092

# --- OpenTelemetry ---
HE_API_OTEL_EXPORTER_OTLP_ENDPOINT=???   # 例：http://localhost:4317（gRPC），或 http://localhost:4318（HTTP）

# --- 日志 ---
HE_API_LOG_LEVEL=info

# --- 监听端口（勿改）---
PORT=8080
