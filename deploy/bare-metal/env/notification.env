# =============================================================================
# He-API Notification Service 环境变量 (监听端口 9004)
# 变量名与 apps/notification-svc 代码严格对应。
# 注意：本服务 Redis 使用 HE_API_REDIS_ADDR + HE_API_REDIS_PASSWORD 两个变量
#       （与其他服务使用的 HE_API_REDIS_URL 不同，请勿混淆）。
# =============================================================================

PORT=9004

HE_API_AUTH_SVC_URL=http://localhost:9001
HE_API_DB_POSTGRES_URI=postgres://he_api:???@localhost:5432/he_api?sslmode=disable
HE_API_KAFKA_BROKERS=localhost:9092
HE_API_REDIS_ADDR=localhost:6379
HE_API_REDIS_PASSWORD=???
SENDGRID_API_KEY=???
