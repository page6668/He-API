# =============================================================================
# He-API Auth Service 环境变量 (监听端口 9001)
# 变量名与 apps/auth-svc 代码严格对应。
# =============================================================================

PORT=9001

# --- 数据库 / 缓存 ---
# 注意：auth-svc 同时读取 HE_API_DB_POSTGRES_URI 与 HE_API_DATABASE_URL，两者都需设置且指向同一库
HE_API_DB_POSTGRES_URI=postgres://he_api:???@localhost:5432/he_api?sslmode=disable
HE_API_DATABASE_URL=postgres://he_api:???@localhost:5432/he_api?sslmode=disable
HE_API_DB_REDIS_URI=redis://localhost:6379/0

# --- JWT 签名（私钥）+ 验签公钥（与网关共用，由 install.sh 自动生成）---
HE_API_JWT_PRIVATE_KEY_PATH=/opt/he-api/keys/jwt_private.pem
HE_API_JWT_PUBLIC_KEY_PATH=/opt/he-api/keys/jwt_public.pem

# --- 审计日志 Kafka（auth-svc 单独使用 AUDIT_KAFKA_BROKERS）---
HE_API_AUDIT_KAFKA_BROKERS=localhost:9092

# --- 通知服务（注册邮件、低余额预警等）---
HE_API_NOTIFICATION_SVC_URL=http://localhost:9004

# --- 控制台地址（OAuth 回调拼装用）---
HE_API_CONSOLE_BASE_URL=https://console.yourdomain.com

# --- KMS 主密钥路径（可选；留空则运行时使用明文兜底，生产强烈建议配置）---
HE_API_KMS_MASTER_KEY_PATH=

# --- TOTP 发行方名（Authenticator App 显示用）---
HE_API_TOTP_ISSUER=He-API

# --- 测试用（生产环境务必留空）---
HE_API_TEST_KEY_NAME=
HE_API_TEST_USER_ID=
