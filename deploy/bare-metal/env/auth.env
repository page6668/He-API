# ============================================================
# He-API Auth Service — 环境变量配置
# 路径：/opt/he-api/env/auth.env
# ============================================================

# --- 数据库 ---
HE_API_DB_POSTGRES_URI=???          # 同 gateway

# --- Redis ---
HE_API_REDIS_URL=???                # 同 gateway

# --- 服务间调用 ---
HE_API_NOTIFICATION_SVC_URL=http://127.0.0.1:9004

# --- Console 地址（用于邮件激活链接）---
HE_API_CONSOLE_BASE_URL=http://127.0.0.1:3000

# --- JWT ---
HE_API_JWT_SECRET=???               # 与 gateway.env 保持一致
HE_API_JWT_ISSUER=https://api.he-api.example.com

# --- Kafka（审计日志）---
HE_API_AUDIT_KAFKA_BROKERS=localhost:9092

# --- OpenTelemetry ---
HE_API_OTEL_EXPORTER_OTLP_ENDPOINT=???

# --- 日志 ---
HE_API_LOG_LEVEL=info

# --- 监听端口 ---
PORT=9001
