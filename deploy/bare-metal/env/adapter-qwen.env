PORT=8092
QWEN_UPSTREAM_API_KEY=???
QWEN_UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_UPSTREAM_TIMEOUT_SECONDS=120
QWEN_BOUND_MODEL_IDS=qwen-plus,qwen-max,qwen2.5-72b-instruct
