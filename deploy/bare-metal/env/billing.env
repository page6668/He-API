# =============================================================================
# He-API Billing Service 环境变量 (监听端口 9002)
# 变量名与 apps/billing-svc 代码严格对应。
# =============================================================================

PORT=9002

HE_API_DB_POSTGRES_URI=postgres://he_api:???@localhost:5432/he_api?sslmode=disable
HE_API_REDIS_URL=redis://localhost:6379/0
HE_API_KAFKA_BROKERS=localhost:9092
HE_API_PAYMENT_SVC_URL=http://localhost:9003

# 低余额预警阈值（USD），低于此值触发通知
HE_API_LOW_BALANCE_THRESHOLD_USD=5.00
