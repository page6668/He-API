# ============================================================
# He-API Billing Service — 环境变量配置
# 路径：/opt/he-api/env/billing.env
# ============================================================

# --- 数据库 ---
HE_API_DB_POSTGRES_URI=???

# --- Redis ---
HE_API_REDIS_URL=???

# --- Kafka ---
HE_API_KAFKA_BROKERS=localhost:9092

# --- OpenTelemetry ---
HE_API_OTEL_EXPORTER_OTLP_ENDPOINT=???

# --- 日志 ---
HE_API_LOG_LEVEL=info

# --- 监听端口 ---
PORT=9002
