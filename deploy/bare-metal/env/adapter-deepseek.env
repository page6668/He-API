# =============================================================================
# DeepSeek Adapter 环境变量 (监听端口 8091)
# 变量名与 apps/adapters/deepseek 代码严格对应。
# =============================================================================

PORT=8091
DEEPSEEK_UPSTREAM_API_KEY=???
DEEPSEEK_UPSTREAM_BASE_URL=https://api.deepseek.com
DEEPSEEK_UPSTREAM_TIMEOUT_SECONDS=120
# 可选：模型名映射（JSON），默认透传
DEEPSEEK_MODEL_MAP={"deepseek-chat":"deepseek-chat","deepseek-reasoner":"deepseek-reasoner"}
