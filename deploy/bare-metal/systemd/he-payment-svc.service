[Unit]
Description=He-API Payment Service
Documentation=https://github.com/he-api/he-api
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=he-api
Group=he-api
WorkingDirectory=/opt/he-api/bin
ExecStart=/opt/he-api/bin/he-payment-svc
EnvironmentFile=/opt/he-api/env/payment.env
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/he-api/logs /opt/he-api/data

[Install]
WantedBy=multi-user.target
