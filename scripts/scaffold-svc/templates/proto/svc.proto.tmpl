// ${DOMAIN}.proto — proto contract for the ${DOMAIN} domain (scaffolded by
// scripts/scaffold-svc.sh, Story 1.5 Q4 ruling). Generated Go code is vendored
// at packages/proto/gen/go/he/${DOMAIN}/v1/.
syntax = "proto3";

package he.${DOMAIN}.v1;

option go_package = "github.com/he-api/he-api/packages/proto/gen/go/he/${DOMAIN}/v1;${DOMAIN}v1";

service ${SVC_PASCAL}Service {
  rpc Ping(PingRequest) returns (PingResponse);
}

message PingRequest {
  string ping = 1;
}

message PingResponse {
  string pong = 1;
}
