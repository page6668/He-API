apiVersion: v1
kind: Service
metadata:
  name: {{ include "${NAME}.fullname" . }}
  labels:
    {{- include "${NAME}.labels" . | nindent 4 }}
spec:
  type: ClusterIP
  ports:
    - name: http
      port: 8080
      targetPort: http
      protocol: TCP
  selector:
    {{- include "${NAME}.selectorLabels" . | nindent 4 }}
